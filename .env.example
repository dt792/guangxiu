# Copy to .env and fill in. Used by both vite build and the node server.

# ---- frontend (vite) ----
# 【生产部署务必保持注释！】该值会在 build 时烧进前端包，
# 一旦填了 127.0.0.1，所有访客的浏览器都会去连他们自己电脑的 5000 端口。
# 仅本地前后端分离开发时才临时打开；生产构建留空 = 同源访问，无跨域问题。
# VITE_API_BASE_URL=http://127.0.0.1:3005/

# ---- node server ----
# 部署到服务器必须改为 0.0.0.0，否则只监听本机回环，外部无法访问
SERVER_HOST=0.0.0.0
# SERVER_PORT=3005
# AI worker auth (must match ai_worker side WORKER_TOKEN)
# 生产环境务必改成强随机串，两端保持一致
WORKER_TOKEN=change-me-worker-token

# ---- cloud APIs ----
# 全部走阿里云百炼，只需这一个 key（百炼控制台 → API-KEY，sk- 开头）
# 注意：是百炼 API-KEY，不是 RAM 的 AccessKeyId/AccessKeySecret
DASHSCOPE_API_KEY=sk-xxx
# 古诗词→提示词用的 LLM（百炼平台模型，可选 deepseek-v3 / qwen-plus 等）
# DASHSCOPE_LLM_MODEL=deepseek-v3
# DASHSCOPE_T2I_MODEL=qwen-image-max
# DASHSCOPE_I2V_MODEL=wan2.7-i2v-2026-04-25
# 国际版 key 需换 base url（控制台开在哪里就用哪里的）：
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
